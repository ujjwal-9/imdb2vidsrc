{
  "manifest_version": 3,
  "name": "IMDB to Vidsrc",
  "version": "1.1",
  "description": "Find titles on IMDB, switch between embed providers, browse episodes, and resume where you left off.",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": [
    "*://*.imdb.com/*",
    "*://*.media-imdb.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IMDb to Vidsrc"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open IMDb to Vidsrc popup"
    },
    "next-episode": {
      "suggested_key": {
        "default": "Alt+Shift+Right",
        "mac": "Alt+Shift+Right"
      },
      "description": "Watch next episode (on a player tab)"
    },
    "prev-episode": {
      "suggested_key": {
        "default": "Alt+Shift+Left",
        "mac": "Alt+Shift+Left"
      },
      "description": "Watch previous episode (on a player tab)"
    },
    "switch-provider": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Cycle to the next enabled provider"
    }
  }
}
