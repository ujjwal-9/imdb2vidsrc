{
  "manifest_version": 3,
  "name": "IMDB to Vidsrc",
  "version": "1.1",
  "description": "Find titles on IMDB, switch between embed providers, browse episodes, and resume where you left off.",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "host_permissions": [
    "*://*.imdb.com/*",
    "*://*.media-imdb.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
